---
import Layout from '../../layouts/Layout.astro';import {radar,href} from '../../lib/data';
---
<Layout title="Actors"><section class="reading wide"><p class="eyebrow">DIRECTORY / ACTORS</p><h1>Actor labels</h1><p class="deck">Original actor labels, grouped by exact text.</p><p class="notice">Aliases and organizational relationships have not been inferred.</p><form id="directory-filters" class="filters" role="search"><div><label for="directory-search">Search actor labels</label><input id="directory-search" type="search" name="q" /></div><div><label for="directory-count">Observations</label><select id="directory-count"><option value="all">All entries</option><option value="observed">With observations</option><option value="watchlist">Without observations</option></select></div></form><p id="directory-results" role="status" aria-live="polite"></p><noscript><p>All entries are listed below. Use your browser’s Find command to search.</p></noscript><ul class="directory">{radar.actors.map(a=><li data-count={a.count}><a href={href(`actors/${a.id}/`)}>{a.name}<span>{a.count} observations ↗</span></a></li>)}</ul></section><script src="../../scripts/directory.ts"></script></Layout>
