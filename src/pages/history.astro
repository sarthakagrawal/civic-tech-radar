---
import Layout from '../layouts/Layout.astro';import {radar,href,dateLabel} from '../lib/data';
---
<Layout title="Import history"><section class="reading"><p class="eyebrow">DATA / HISTORY</p><h1>Observation history</h1><p class="deck">Counts reconstructed from original observed dates.</p><p class="notice">This is an observation-date history, not a claim that these records were publicly published on those dates.</p><ul class="timeline">{[...radar.history].reverse().map(h=><li><time datetime={h.date}>{dateLabel(h.date)}</time><span>{h.added.length} observations · {h.total} cumulative</span><details><summary>View records</summary><ul>{h.added.map(id=>{const s=radar.signals.find(s=>s.id===id)!;return <li><a href={href(`signals/${id}/`)}>{s.title}</a></li>})}</ul></details></li>)}</ul></section></Layout>
