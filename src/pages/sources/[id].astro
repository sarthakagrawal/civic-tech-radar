---
import Layout from '../../layouts/Layout.astro';import {radar,href,display,dateLabel} from '../../lib/data';
export function getStaticPaths(){return radar.sources.map(source=>({params:{id:source.id},props:{source}}));}const {source}=Astro.props;const signals=radar.signals.filter(s=>s.sourceId===source.id);
---
<Layout title={source.name}><section class="reading"><a class="back" href={href('sources/')}>← Sources</a><p class="eyebrow">SOURCE / {display(source.sourceType)}</p><h1 class="detail-title">{source.name}</h1><p>{signals.length} historical observations</p>{source.url?<a class="primary-link" href={source.url} rel="noreferrer">Open watchlist URL ↗</a>:<p class="notice">Watchlist URL: unknown. Each observation retains its own source link.</p>}<h2>Observation timeline</h2>{signals.length?<ul class="timeline">{signals.map(s=><li><time datetime={s.date}>{dateLabel(s.date)}</time><a href={href(`signals/${s.id}/`)}>{s.title}</a><span>{display(s.stage)}</span></li>)}</ul>:<p>No observations in this snapshot. This source appears in the historical watchlist.</p>}</section></Layout>
