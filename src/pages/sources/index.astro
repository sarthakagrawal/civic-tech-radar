---
import Layout from '../../layouts/Layout.astro';import {radar,href} from '../../lib/data';
---
<Layout title="Sources"><section class="reading wide"><p class="eyebrow">DIRECTORY / SOURCES</p><h1>Sources</h1><p class="deck">Source labels in the historical tracker and its watchlist.</p><p class="notice">Watchlist entries with no observations remain labeled as such. Discovery candidates are excluded.</p><ul class="directory">{radar.sources.map(s=><li><a href={href(`sources/${s.id}/`)}>{s.name}<span>{s.count} observations ↗</span></a></li>)}</ul></section></Layout>
