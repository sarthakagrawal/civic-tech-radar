---
import Layout from '../../layouts/Layout.astro';import {radar,href} from '../../lib/data';
---
<Layout title="Sources"><section class="reading wide"><p class="eyebrow">DIRECTORY / SOURCES</p><h1>Sources</h1><p class="deck">Source labels in the historical tracker and its watchlist.</p><p class="notice">Watchlist entries with no observations remain labeled as such. Discovery candidates are excluded.</p><form id="directory-filters" class="filters" role="search"><div><label for="directory-search">Search sources</label><input id="directory-search" type="search" name="q" /></div><div><label for="directory-count">Observations</label><select id="directory-count"><option value="all">All entries</option><option value="observed">With observations</option><option value="watchlist">Without observations</option></select></div></form><p id="directory-results" role="status" aria-live="polite"></p><noscript><p>All entries are listed below. Use your browser’s Find command to search.</p></noscript><ul class="directory">{radar.sources.map(s=><li data-count={s.count}><a href={href(`sources/${s.id}/`)}>{s.name}<span>{s.count} observations ↗</span></a></li>)}</ul></section><script src="../../scripts/directory.ts"></script></Layout>
