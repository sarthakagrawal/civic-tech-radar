---
import Layout from '../layouts/Layout.astro';
import {radar,href,display,dateLabel} from '../lib/data';
const stages=[...new Set(radar.signals.map(s=>s.stage))].sort();
const types=[...new Set(radar.signals.map(s=>s.sourceType))].sort();
const sectors=stages.map((stage,i)=>{const a=i*Math.PI/3-Math.PI/2;return {stage,x:450+260*Math.cos(a),y:250+235*Math.sin(a),x2:450+200*Math.cos(a-Math.PI/6),y2:245+200*Math.sin(a-Math.PI/6)};});
const points=radar.signals.map(s=>{const i=radar.signals.filter(x=>x.stage===s.stage).findIndex(x=>x.id===s.id);const a=stages.indexOf(s.stage)*Math.PI/3-Math.PI/2+((i%5)-2)*.17;const r=66+Math.floor(i/5)*10;return {...s,x:450+r*Math.cos(a),y:245+r*Math.sin(a)};});
---
<Layout><section class="hero"><div><p class="eyebrow">ARTICLE ONE / CIVIC TECH RADAR</p><h1>Civic Tech<br/><em>Radar.</em></h1><p class="deck">Historical observations · Congress &amp; civic technology</p><div class="snapshot"><span class="dot"></span> Snapshot through {dateLabel(radar.asOf!)}<a href={href('about/')}>View provenance ↗</a></div></div><aside class="hero-stats" aria-label="Dataset summary"><strong>{radar.signals.length}<span>observations</span></strong><div><b>{radar.sources.filter(s=>s.count>0).length}</b> named sources</div><div><b>{radar.actors.length}</b> actor labels</div><small>Original labels. Linked sources.</small></aside></section>
<section class="explorer" aria-labelledby="explorer-heading"><div class="section-top"><h2 id="explorer-heading">Explore observations</h2><a href={href('exports/signals.csv')} download>Download CSV ↓</a></div><form id="filters" class="filters" role="search"><div class="search-field"><label for="search">Search the record</label><input id="search" name="q" type="search" placeholder="Title, source or actor…"/></div><div><label for="stage">Original stage</label><select id="stage" name="stage"><option value="">All stages</option>{stages.map(stage=><option>{stage}</option>)}</select></div><div><label for="source-type">Source type</label><select id="source-type" name="type"><option value="">All source types</option>{types.map(type=><option>{type}</option>)}</select></div><div><label for="sort">Sort observations</label><select id="sort" name="sort"><option value="newest">Newest observed</option><option value="oldest">Oldest observed</option><option value="title">Title A–Z</option></select></div><button type="reset" class="reset">Reset</button></form><noscript><p class="notice">All observations are listed below, newest first. Use your browser’s Find command to search. Every source, actor and observation page works without JavaScript.</p></noscript><div class="results-bar"><p id="result-count" role="status" aria-live="polite">{radar.signals.length} observations</p><div class="view-controls" hidden id="view-controls"><button id="table-view" type="button" aria-pressed="true">Table</button><button id="radar-view" type="button" aria-pressed="false">Radar</button></div></div>
<div id="radar-panel" hidden><p class="notice">Stages are categories, not scores. Each point links to one observation. The table contains the same records.</p><div class="radar-scroll"><svg class="radar" viewBox="0 0 900 520" role="img" aria-labelledby="radar-title radar-description"><title id="radar-title">Observations by original stage</title><desc id="radar-description">Six sectors group original stage labels. Distance from the center only separates points and does not indicate importance. Use the table for a text equivalent.</desc><circle cx="450" cy="245" r="200" class="ring"/><circle cx="450" cy="245" r="140" class="ring"/><circle cx="450" cy="245" r="80" class="ring"/>{sectors.map(sector=><g><line x1="450" y1="245" x2={sector.x2} y2={sector.y2} class="ring"/><text x={sector.x} y={sector.y} text-anchor="middle">{sector.stage}</text></g>)}{points.map(s=><a href={href(`signals/${s.id}/`)} data-signal-id={s.id} aria-label={`${s.title}, ${s.stage}`}><circle cx={s.x} cy={s.y} r="4"><title>{s.title}</title></circle></a>)}</svg></div></div>
<div id="table-panel"><table><caption class="sr-only">Historical observations with original stage, source and observed date</caption><thead><tr><th scope="col">Observation</th><th scope="col">Original stage</th><th scope="col">Source</th><th scope="col">Observed</th></tr></thead><tbody id="observations">{radar.signals.map(s=><tr data-id={s.id} data-date={s.date??''} data-title={s.title} data-stage={s.stage} data-type={s.sourceType} data-search={`${s.title} ${s.source} ${s.actor}`.toLowerCase()}><td><a class="signal-title" href={href(`signals/${s.id}/`)}>{s.title}</a><span class="actor-label">{display(s.actor)}</span></td><td><span class="stage">{display(s.stage)}</span></td><td><a class="source-link" href={href(`sources/${s.sourceId}/`)}>{s.source}</a></td><td><time datetime={s.date}>{dateLabel(s.date)}</time></td></tr>)}</tbody></table></div><p id="empty" class="notice" hidden>No observations match these filters. Try a different search or reset the filters.</p></section><script src="../scripts/explorer.ts"></script></Layout>
