---
import Layout from '../../layouts/Layout.astro';import {radar,href,display,dateLabel} from '../../lib/data';
export function getStaticPaths(){return radar.signals.map(signal=>({params:{id:signal.id},props:{signal}}));}
const {signal}=Astro.props;
const related=radar.signals.filter(s=>s.link===signal.link&&s.id!==signal.id);
---
<Layout title={signal.title}><article class="reading"><a class="back" href={href()}>← All observations</a><p class="eyebrow">HISTORICAL OBSERVATION / ROW {signal.row}</p><h1 class="detail-title">{signal.title}</h1><p class="observation-label">Title and labels preserved from the historical tracker.</p><dl class="facts"><div><dt>Observed</dt><dd><time datetime={signal.date}>{dateLabel(signal.date)}</time></dd></div><div><dt>Original stage</dt><dd>{display(signal.stage)}</dd></div><div><dt>Source</dt><dd><a href={href(`sources/${signal.sourceId}/`)}>{signal.source}</a></dd></div><div><dt>Actor label</dt><dd><a href={href(`actors/${signal.actorId}/`)}>{display(signal.actor)}</a></dd></div><div><dt>Original source type</dt><dd>{display(signal.sourceType)}</dd></div></dl><a class="primary-link" href={signal.link} rel="noreferrer">Open original source ↗</a><p class="url-display">{signal.link}</p><section class="provenance"><h2>Record provenance</h2><p>Historical tracker · Signals sheet · row {signal.row}</p><p>Snapshot through {radar.asOf}. Original stage labels are historical annotations; source availability and current status may differ.</p><p>Generated summaries, relevance judgments and “why it matters” commentary are excluded from this public edition.</p><a href={href('about/')}>Import details and field policy</a></section>{related.length>0&&<section><h2>Other observations at this URL</h2><ul class="timeline">{related.map(s=><li><time>{dateLabel(s.date)}</time><a href={href(`signals/${s.id}/`)}>{s.title}</a><span>{s.stage}</span></li>)}</ul></section>}</article></Layout>
