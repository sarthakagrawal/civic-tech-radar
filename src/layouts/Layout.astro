---
import disclosures from '../lib/package-disclosures.json';
import '../styles/global.css';
import {href,radar} from '../lib/data';
const {title='Civic Tech Radar'}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="Civic Tech Radar — historical observations, source links and original stage labels."/><meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; require-trusted-types-for 'script'; trusted-types 'none'"/><title>{title} · Article One</title></head><body><a class="skip" href="#main">Skip to content</a><header class="site-header"><a class="brand" href="/">ARTICLE ONE<span> / </span></a><a class="product" href={href()}>Civic Tech Radar</a><nav aria-label="Main navigation"><a href={href()}>Explore</a><a href={href('sources/')}>Sources</a><a href={href('actors/')}>Actors</a><a href={href('about/')}>Data &amp; method</a></nav></header><main id="main"><slot/></main><footer><a href={href()}>Civic Tech Radar</a><span>Historical snapshot · {radar.asOf}</span><a href={href('exports/signals.csv')} download>Download CSV</a><a href={href('exports/radar.json')} download>Download JSON</a><a href={href('history/')}>Import history</a><a href="https://github.com/sarthakagrawal/civic-tech-radar">Source code</a><p class="software-notices">{disclosures.filter(p=>['astro','arktype'].includes(p.name)).map(p=><span><a href={p.source}>{p.name === 'astro' ? 'Astro' : 'ArkType'} {p.version}</a> (<a href="/data/civic-tech-radar/notices.txt">{p.license}</a>; <a href={p.name === 'astro' ? '/open-source#open-source-astro-civic-tech-radar' : '/open-source#open-source-arktype'}>details</a>) · </span>)}<a href="/data/civic-tech-radar/notices.txt">Full software notices</a></p></footer></body></html>
